[Unit]
Description=FeedVision RPi Core (FastAPI/uvicorn)
# Seri port cihaz katmani hazir olsun diye bekler ama servis onu ZORUNLU
# kilmaz (Requires degil) -- STM32 USB kablosu takili degilse/gec enumerate
# olsa da FastAPI acilir; port secimi zaten operator UI'dan runtime'da
# yapiliyor (bkz. /serial/connect), boot aninda seri porta ihtiyac yok.
After=network-online.target systemd-udev-settle.service
Wants=network-online.target

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_GROUP__
WorkingDirectory=__APP_DIR__/rpi-core
ExecStart=__APP_DIR__/rpi-core/.venv/bin/python3 -m uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3
# Ard arda hizli crash-loop'ta CPU'yu yakip lokmayi disari atmasin diye
# sinirlama: 10 dakikada 10'dan fazla basarisiz baslatmada systemd durur,
# `systemctl status feedvision` ile sebep gorulur.
StartLimitIntervalSec=600
StartLimitBurst=10

# journald'e yazsin (loglar `journalctl -u feedvision -f` ile izlenir)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=feedvision

# Kamera/seri port erisimi icin gerekli gruplar (Raspberry Pi OS varsayilani)
SupplementaryGroups=dialout video

# Hafiza sizintisi ihtimaline karsi guvenlik supabı: RPi 5 (4/8GB) icin makul
# bir tavan; asilirsa systemd servisi yeniden baslatir (OOM ile ugrasmaz).
MemoryMax=1G

[Install]
WantedBy=multi-user.target
